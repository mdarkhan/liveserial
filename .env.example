# PostgreSQL. Must be a direct/session connection (LISTEN/NOTIFY does not work through a
# transaction-mode pooler). Local dev: `npm run db:start` serves this URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/liveserial"

# Better Auth: a long random secret (e.g. `openssl rand -base64 32`).
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"
# Public base URL of the app, used for auth callbacks and patient links in SMS.
APP_BASE_URL="http://localhost:3000"

# SMS provider: "console" (development; prints to stdout).
SMS_PROVIDER="console"

# Super admin created by `npm run db:seed` (phone: 01XXXXXXXXX).
SEED_SUPERADMIN_PHONE="01700000000"
SEED_SUPERADMIN_PASSWORD="change-me"
